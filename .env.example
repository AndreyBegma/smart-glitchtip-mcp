# Copy to .env and fill in. See README.md#configuration for the full table.
# No real values belong in this file — placeholders only.

# stdio | http (default stdio)
MCP_TRANSPORT=http
# HTTP port (default 8080)
MCP_HTTP_PORT=8080
# HTTP endpoint path (default /mcp)
MCP_HTTP_PATH=/mcp
# Shared secret for HTTP clients that do not bring their own GlitchTip token.
# Required in HTTP mode when GLITCHTIP_TOKEN is set; at least 16 characters, no whitespace.
MCP_AUTH_TOKEN=replace-with-a-random-32-char-secret

# Default GlitchTip instance. Required in stdio mode.
GLITCHTIP_URL=https://glitchtip.example.com
# Default GlitchTip API token. Never commit a real value.
GLITCHTIP_TOKEN=replace-with-your-glitchtip-api-token
# Default organization slug (optional)
GLITCHTIP_DEFAULT_ORG=
# Comma list of other instance origins an HTTP client may select with
# X-GlitchTip-Url (default empty: only GLITCHTIP_URL is accepted)
GLITCHTIP_ALLOWED_URLS=
# Comma list of enabled toolsets, or "all" (default organizations,issues,events,projects)
GLITCHTIP_TOOLSETS=organizations,issues,events,projects
# false registers the tools that change or delete data (default true)
GLITCHTIP_READ_ONLY=true
# Timeout in ms for each request to GlitchTip (default 15000)
GLITCHTIP_TIMEOUT_MS=15000
# Maximum size in characters of a tool result (default 20000)
MCP_RESPONSE_BUDGET=20000
# pino log level: fatal|error|warn|info|debug|trace|silent (default info)
LOG_LEVEL=info
