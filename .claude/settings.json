{
  "permissions": {
    "allow": ["Bash(gh pr merge:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/orchestrator/fence.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
