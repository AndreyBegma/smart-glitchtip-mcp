{
  "name": "smart-glitchtip-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives agents the full working surface of a GlitchTip instance",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreyBegma/smart-glitchtip-mcp.git"
  },
  "bin": {
    "smart-glitchtip-mcp": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --watch dist/main.js)",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "api:generate": "openapi-typescript docs/reference/glitchtip-openapi.json -o src/glitchtip/generated/schema.d.ts",
    "api:sync": "node scripts/api/sync.mjs && bun run api:generate"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.1.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/microservices": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@rekog/mcp-nest": "2.0.7",
    "express": "5.2.1",
    "hono": "4.13.9",
    "nestjs-pino": "5.2.1",
    "openapi-fetch": "0.17.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.1.0",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.6",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
